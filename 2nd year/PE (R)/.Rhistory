lim_inf <- medias - z * erro_padrao
lim_sup <- medias + z * erro_padrao
contem_mu <- (lim_inf <= mu) & (mu <= lim_sup)
proporcao_contem <- mean(contem_mu)
quociente <- proporcao_contem / gamma
cat("Proporção de ICs que contêm o valor verdadeiro:", round(proporcao_contem, 4), "\n")
cat("Quociente (proporção / gamma):", round(quociente, 4), "\n")
set.seed(1036)
m <- 1700
n <- 12
mu <- 0.1
sigma <- 1.4
gamma <- 0.91
alpha <- 1 - gamma
z <- qnorm(1 - alpha/2)
amostras <- matrix(rnorm(m * n, mean = mu, sd = sigma), nrow = m, ncol = n)
medias <- rowMeans(amostras)
erro_padrao <- sigma / sqrt(n)
lim_inf <- medias - z * erro_padrao
lim_sup <- medias + z * erro_padrao
contem_mu <- (lim_inf <= mu) & (mu <= lim_sup)
proporcao_contem <- mean(contem_mu)
quociente <- round(proporcao_contem / gamma,4)
quociente
# Definir parâmetros
set.seed(2084)
m <- 1000
n <- 27
mu0 <- 2.0
mu1 <- 2.2
alpha <- 0.1
# Valor crítico da qui-quadrado com 2n graus de liberdade
crit_value <- qchisq(1 - alpha, df = 2 * n)
# Inicializar contador de rejeições
rejections <- 0
# Simulação: gerar m amostras e aplicar o teste
for (i in 1:m) {
sample <- rexp(n, rate = 1 / mu1)
x_bar <- mean(sample)
T0 <- 2 * n * x_bar / mu0
if (T0 > crit_value) {
rejections <- rejections + 1
}
}
# Estimativa de beta (erro de 2ª espécie)
beta_hat <- 1 - (rejections / m)
# Valor teórico de beta
beta_theoretical <- pchisq(crit_value * (mu0 / mu1), df = 2 * n)
# Quociente
quotient <- beta_hat / beta_theoretical
# Mostrar resultados
cat("Beta estimado (beta_hat):", beta_hat, "\n")
cat("Beta teórico:", beta_theoretical, "\n")
cat("Quociente arredondado:", round(quotient, 4), "\n")
# Definir parâmetros
set.seed(2084)
m <- 1000
n <- 27
mu0 <- 2.0
mu1 <- 2.2
alpha <- 0.1
# Valor crítico da qui-quadrado com 2n graus de liberdade
crit_value <- qchisq(1 - alpha, df = 2 * n)
# Inicializar contador de rejeições
rejections <- 0
# Simulação: gerar m amostras e aplicar o teste
for (i in 1:m) {
sample <- rexp(n, rate = 1 / mu1)
x_bar <- mean(sample)
T0 <- 2 * n * x_bar / mu0
if (T0 > crit_value) {
rejections <- rejections + 1
}
}
# Estimativa de beta (erro de 2ª espécie)
beta_hat <- 1 - (rejections / m)
# Valor teórico de beta
beta_theoretical <- pchisq(crit_value * (mu0 / mu1), df = 2 * n)
# Quociente
quociente <- round(beta_hat / beta_theoretical,4)
quociente
