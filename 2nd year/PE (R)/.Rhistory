# Parâmetros
set.seed(4469)  # Fixar semente para reprodutibilidade
m <- 100
n <- 12
x <- 6.25
k_vals <- 0:floor(x)
# Função para o termo da soma
terms <- sapply(k_vals, function(k) {
(-1)^k * choose(n, k) * (x - k)^n
})
# Soma e divisão por n!
pn <- sum(terms) / factorial(n)
pn
# Aproximação pelo TLC
media <- n*(0+1)/2
Variancia <-  n*(1-0)^2/12
pn_tlc <- pnorm(x, mean = media, sd = Variancia)
pn_tlc
# Gerar amostras e calcular as somas
amostras <- matrix(runif(m * n, 0, 1), nrow = m, ncol = n)
somas <- rowSums(amostras)
# Calcular a proporção de somas <= 5.75
pn_sim <- mean(somas <= x)
pn_sim
# Cálculo do desvio absoluto pn_ylc
desvio_absolutoTLC <- abs(pn - pn_tlc)
desvio_absolutoTLC
# Cálculo do desvio absoluto pn_sim
desvio_absolutoSIM <- abs(pn - pn_sim)
desvio_absolutoSIM
# Cálculo do quociente
quociente <- desvio_absolutoTLC / desvio_absolutoSIM
# Arredondamento para 4 casas decimais
quociente_arredondado <- round(quociente, 4)
quociente_arredondado
